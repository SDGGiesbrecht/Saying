ability (clients)
 (
  English: use of (node) as parsed syntax node
 )
 {
  ability (clients)
   general use of (node)

  requirement (clients)
   [
    test {ignore ((example: node) as node)}
   ]
   (
    English: (node: node) as node
    Swift: ParsedSyntaxNode.init (node: [node])
   )
   parsed syntax node

  requirement (clients)
   [
    test {ignore (children of (example: node))}
   ]
   (
    English: children of (node: node)
    Swift: var (self: [node]).children
   )
   list of (parsed syntax node)
 }
